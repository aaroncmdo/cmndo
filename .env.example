TWILIO_TPL_DOKUMENTE_NACHREICHEN=
TWILIO_TPL_RECHNUNG_VERFUEGBAR=

# ─── Lexoffice ──────────────────────────────────────────
LEXOFFICE_API_KEY=

# ─── Google Ads ─────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# ─── Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Linear (AAR-518 Support-Bot) ──────────────────────
# Personal API Key aus Linear Settings > API, Team-ID aus der Team-URL
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ─── E2E Tests (KFZ-185) ───────────────────────────────
# Test-User Credentials (NICHT Production-User!)
TEST_ADMIN_EMAIL=test-admin@claimondo.de
TEST_ADMIN_PASSWORD=Test1234!
TEST_SV_EMAIL=test-sv@claimondo.de
TEST_SV_PASSWORD=Test1234!
# Optional: Vercel Preview URL statt localhost
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ─── LinkedIn Auto-Posting (Company-Page) ──────────────
# Siehe docs/linkedin-auto-posting-setup.md fuer die einmalige Einrichtung.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ID=            # numerische ID ODER urn:li:organization:<id>
LINKEDIN_REDIRECT_URI=https://app.claimondo.de/api/auth/linkedin/callback
MARKETING_FEED_URL=https://claimondo.de/feed.json

# ─── Web-Push (VAPID, AAR-499) ─────────────────────────
# Neues Schluesselpaar erzeugen: npx web-push generate-vapid-keys
# Beide werden zur Laufzeit SERVER-seitig gelesen (web-push.ts sendet, health-check
# config-required-env prueft). Solange kein Client-Subscribe-Flow (pushManager.subscribe)
# existiert, ist NEXT_PUBLIC_VAPID_PUBLIC_KEY ein Runtime-Lookup (nicht build-inlined) —
# ENV setzen + Neustart genuegt, kein Rebuild.
# ACHTUNG: Der Server-Send-Pfad ist damit bereit, ABER der Client-Subscribe-Flow fehlt
# noch -> ohne ihn entstehen keine push_subscriptions (Push liefert 0).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=tech@claimondo.de

# --- Marketing Content-Studio (Slice 1) ---
PEXELS_API_KEY=                          # Stock-B-Roll (gratis: https://www.pexels.com/api/). Ohne Key -> nur Grafik-Fallback.
ELEVENLABS_VOICE_ID=HNYELfQMgCeL9N0RGyxo # Deutsche ElevenLabs-Stimme (public, kein Secret)
MARKETING_STUDIO_ENABLED=true            # Kill-Switch (false = Generierung global aus)
MARKETING_MAX_CLIPS_PER_WEEK=20          # Kosten-Cap (max. Clips/Woche)
# Piper-Fallback (OSS-TTS wenn ElevenLabs 402/fehlschlaegt) - nur VPS:
PIPER_BIN=piper                          # oder voller Pfad zum piper/python-Binary
PIPER_MODEL=                             # Pfad zur .onnx-Stimme (z.B. .../de_DE-thorsten-medium.onnx)
