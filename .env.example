# ─── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Google SMTP (existing) ────────────────────────────
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
GMAIL_SMTP_FROM=Claimondo <noreply@claimondo.de>

# ─── Sentry (KFZ-174) ──────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Analytics / Tracking (alle optional; nur gesetzt = aktiv) ──
# Google Analytics 4 Measurement-ID (Format G-XXXXXXXXXX). Aktiviert den
# gtag.js-Loader in src/app/layout.tsx — NUR auf claimondo.de/www, consent-gated.
NEXT_PUBLIC_GA4_ID=
# Google Ads Conversion-ID (Format AW-XXXXXXXXX). Teilt sich den gtag.js-Loader.
NEXT_PUBLIC_GADS_ID=
# Microsoft Clarity Project-ID (Session-Recording/Heatmaps). Consent-gated auf
# Public-Seiten (laedt erst nach "Alle akzeptieren").
NEXT_PUBLIC_CLARITY_ID=
# Google Tag Manager Container-ID fuer den GF-Embed (/embed/gutachter-finder),
# Format GTM-XXXXXXX. BEWUSST server-seitig + runtime-gelesen (KEIN NEXT_PUBLIC_: Var
# setzen + Restart statt Rebuild; siehe src/app/embed/gutachter-finder/page.tsx). Leer
# = kein GTM im Embed. Consent-Gating + Enhanced-Conversions konfiguriert GTM selbst.
GF_GTM_ID=

# ─── Resend (KFZ-174) ──────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Claimondo <noreply@claimondo.de>
# Optional: Reply-To Adresse (default: gleich wie RESEND_FROM)
# RESEND_REPLY_TO=support@claimondo.de

# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.claimondo.de
CRON_SECRET=
# BUG-105: HMAC-Secret fuer Realtime-Channel-Hashing (32 byte hex, z.B. openssl rand -hex 32)
SUPABASE_REALTIME_SECRET=

# ─── Google APIs ────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ─── Mapbox (AAR-380 Block G Field-Modus) ──────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Feldmodus Phase 4 — 3D Tiles ──────────────────────
# OPTION A: Cesium Ion (BEVORZUGT — in EEA verfügbar)
# Free-Tier: 5GB / 100k Requests/Monat, Pro ab $50/Monat.
# Asset 2275207 = Cesium OSM Buildings (default, fotorealistic genug).
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_FELDMODUS_CESIUM_TILES=false
NEXT_PUBLIC_CESIUM_ION_ASSET_ID=2275207

# OPTION B: Google Photorealistic 3D Tiles (in EEA seit 2024 GESPERRT
# wegen DSA/DMA-Regulierung — nur außerhalb der EEA nutzbar)
NEXT_PUBLIC_GOOGLE_MAPS_3D_TILES_KEY=
NEXT_PUBLIC_FELDMODUS_GOOGLE_TILES=false

# ─── Feldmodus HERE Hazards (Verkehrshindernisse) ──────
# Speed-Cameras NICHT verfügbar via HERE Standard-API.
# Aber: Baustellen, Sperrungen, Pannen-Fahrzeuge, Unfälle.
NEXT_PUBLIC_HERE_API_KEY=

# ─── Feldmodus ElevenLabs TTS (schönere Voice) ─────────
# Free-Tier 10k Characters/Monat. Fallback auf Web Speech API.
# Server-Side-Key (sk_-Prefix), läuft über /api/elevenlabs/tts Proxy.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ─── Cardentity (Vorschaden-Recherche) ─────────────────
# Default-URL: https://api.cardentity.eu (EU-Region). Override hier
# wenn ihr eine andere Region nutzt.
CARDENTITY_API_URL=
CARDENTITY_CLIENT_ID=
CARDENTITY_CLIENT_SECRET=
# Optionaler Direct-Token-Override für Smoke-Tests bevor OAuth steht.
# Cardentity-Tokens sind nur 1h gültig — danach im Dashboard neuen Token
# generieren. Wenn gesetzt, springt getAccessToken() OAuth komplett aus.
CARDENTITY_ACCESS_TOKEN=

# ─── Twilio ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

