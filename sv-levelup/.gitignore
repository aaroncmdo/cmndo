# sv-levelup · standalone Next.js — eigener .gitignore. Die Root-.gitignore von
# claimondo-v2 nutzt `/node_modules` und `/.next/` mit fuehrendem Slash und
# matcht damit NUR Root-Level, nicht dieses Unterprojekt. Ohne diese Datei
# landen ~23.000 Build-Artefakte im Commit (beim Anlegen per Dry-Run gefangen).
# Gleiches Muster wie claimondo-marketing/.gitignore.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-cli/
