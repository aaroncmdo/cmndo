# sv-levelup.claimondo.de — Laufzeit-Umgebung
#
# Auf dem VPS wird die echte .env.local aus dem kanonischen
# /etc/claimondo/.env.local generiert (Muster: deploy-vps-marketing.yml).
# Lokal: aus dem Repo-Root kopieren, es ist dieselbe Datenbank.

# Supabase — dieselbe Instanz wie das Portal (paizkjajbuxxksdoycev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places (New) — zwei getrennte Keys, weil die SKU-Stufen unterschiedlich
# teuer sind und eigene Gratiskontingente haben (Design-Spec §5.5.4, §7):
#   Messung   = Enterprise-Felder (rating, userRatingCount, websiteUri), 1.000/Monat frei
#   Discovery = nur Pro-Felder,                                          5.000/Monat frei
# Getrennte Keys verhindern, dass ein Scrape-Lauf das Kontingent der Checks frisst.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DISCOVERY_KEY=
